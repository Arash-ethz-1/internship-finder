# Copy to backend/.env and fill in. .env is gitignored; this file is not.
#
# Neither key is needed for `cli ingest` or the postings API. They are only
# required at the point of use, and config.py names the missing one if you
# forget.

# The agent and letter drafting. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Embeddings. https://dashboard.voyageai.com/api-keys
VOYAGE_API_KEY=

# Reading application replies out of Gmail (`cli sync-email`). Read-only, and
# entirely optional: every other command works without these.
#
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
#   1. Enable the Gmail API for the project.
#   2. Create credentials -> OAuth client ID -> Application type "Desktop app".
#   3. Paste the client ID and secret below.
# The first `cli sync-email --login` opens a browser once and stores a refresh
# token in data/gmail_token.json, which is gitignored.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional overrides -------------------------------------------------------

# Swap to claude-sonnet-5 if the agent loop gets expensive while iterating.
# AGENT_MODEL=claude-opus-5

# Classifying one email is a subject line and a preview, so it runs on the
# cheap model by default.
# CLASSIFIER_MODEL=claude-sonnet-5

# Where embeddings come from: "local" or "voyage".
#
# local   runs an ONNX model on this machine through fastembed. No key, no
#         rate limit, no per-token cost, so re-embedding the corpus while
#         tuning chunking is free. Slower, and the small default model is
#         weaker than a paid one.
# voyage  calls the Voyage API and needs VOYAGE_API_KEY above.
EMBEDDING_PROVIDER=local

# Changing either of these invalidates data/vectors.npy and forces a re-embed;
# load_vectors() refuses to mix two vector spaces rather than quietly ranking
# nonsense. Leave them unset and the provider picks its own pair:
#   local   sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2, 384
#   voyage  voyage-3.5, 1024
#
# For a much stronger local model at roughly 20x the CPU time (and 2.2 GB of
# download), and where a GPU is worth borrowing:
#   EMBEDDING_MODEL=intfloat/multilingual-e5-large
#   EMBEDDING_DIM=1024
# EMBEDDING_MODEL=
# EMBEDDING_DIM=

# Where fastembed keeps downloaded models. Defaults to a system temp folder,
# which some machines clear on reboot.
# FASTEMBED_CACHE_PATH=

# API_HOST=127.0.0.1
# API_PORT=8000
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
